# ==============================================
# 基础配置 (App Configuration)
# ==============================================
PROJECT_NAME="Drone_win"
VERSION="1.0.0"
DEBUG=True

# ==============================================
# 数据库配置 (Database Configuration)
# ==============================================
# 格式详解: postgresql+asyncpg://用户名:密码@地址:端口/数据库名
# 注意: 必须使用 postgresql+asyncpg 协议以支持异步操作
DATABASE_URL=postgresql+asyncpg://postgres:123456@localhost:5432/smart_seeding_db

# ==============================================
# 如果你之后打算使用 Docker，通常也可以拆分写 (可选，目前代码主要读取 DATABASE_URL)
# ==============================================
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_password
# POSTGRES_SERVER=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=smart_seeding_db

# ==============================================
# 文件存储路经 (为之后的 DEM/Tiff/Shp 预留)
# ==============================================
# 建议配置一个绝对路径，用于存放上传的 GIS 数据
# FILE_STORAGE_PATH=./data_storage
